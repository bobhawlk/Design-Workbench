{
  "schema": "lcw-solidcraft-profile/1",
  "about": "How inv2sc's operations map onto SolidCraft commands. Written against SolidCraft 0.44 (main, November 2026). When a SolidCraft update renames a command or a parameter, change it here (or pass --profile with a copy): `inv2sc probe` checks every entry against the running SolidCraft and says which ones no longer fit.",
  "tested_with": ["0.44.1"],
  "ops": {
    "insert_step":       {"command": "file.insert_step",           "params": {"path": "path", "name": "name", "names": "names"}, "timeout_s": 600},
    "sheet_rule":        {"command": "sheet.manage_rules",         "params": {"name": "name", "thickness": "thickness", "k_factor": "k_factor", "bend_radius": "bend_radius", "active": "active"}},
    "sheet_convert":     {"command": "sheet.convert",              "params": {"body": "body", "face": "face", "bends": "bends", "rule": "rule"}, "timeout_s": 600,
                          "retry_dropping_point": {"param": "bends", "when": ["closes a loop of bends", "a chamfer picked as a bend that runs along a face more than once"]}},
    "doc_metadata":      {"command": "document.metadata.set",      "params": {"values": "values", "key": "key", "value": "value"}},
    "component_metadata":{"command": "component.metadata.set",     "params": {"component": "component", "part_number": "part_number", "description": "description", "revision": "revision", "material": "material", "properties": "properties"}},
    "insert_design":     {"command": "component.insert_design",    "params": {"path": "path", "name": "name", "parent": "parent"}},
    "create_component":  {"command": "component.create",           "params": {"name": "name", "parent": "parent", "activate": "activate", "grounded": "grounded"}},
    "copy_occurrence":   {"command": "occurrence.copy",            "params": {"component": "component", "parent": "parent"}},
    "place":             {"command": "occurrence.move",            "params": {"occurrence": "occurrence", "to_matrix": "to_matrix", "move_grounded": "move_grounded", "translate": "translate", "space": "space"}},
    "ground":            {"command": "occurrence.ground",          "params": {"occurrence": "occurrence", "grounded": "grounded"}},
    "rigid_group":       {"command": "joint.rigid_group",          "params": {"occurrences": "occurrences"}},
    "joint":             {"command": "joint.create",               "params": {"type": "type", "a": "a", "b": "b", "flip": "flip", "name": "name", "limits": "limits", "quiet": "quiet"}},
    "constraint":        {"command": "assembly.constraint.create", "params": {"type": "type", "a": "a", "b": "b", "offset": "offset", "angle": "angle", "flip": "flip", "name": "name", "quiet": "quiet"}},
    "find_limits":       {"command": "joint.find_limits",          "params": {"joint": "joint", "index": "index", "step": "step", "refine": "refine", "occurrences": "occurrences", "against": "against", "exclude_pairs": "exclude_pairs"}, "timeout_s": 900},
    "sweep":             {"command": "joint.sweep",                "params": {"joint": "joint", "index": "index", "from": "from", "to": "to", "step": "step", "refine": "refine", "occurrences": "occurrences", "against": "against", "exclude_pairs": "exclude_pairs", "budget_s": "budget_s", "apply": "apply"}, "timeout_s": 300},
    "set_limits":        {"command": "joint.limits",               "params": {"joint": "joint", "index": "index", "min": "min", "max": "max"}},
    "parameter":         {"command": "parameters.change",          "params": {"name": "name", "expression": "expression", "comment": "comment"}},
    "list_bodies":       {"command": "inspect.measure",            "params": {"names_only": "names_only"}},
    "joint_list":        {"command": "joint.list",                 "params": {"quiet": "quiet"}},
    "drive":             {"command": "joint.drive",                "params": {"joint": "joint", "value": "value", "quiet": "quiet"}},
    "undo":              {"command": "edit.undo",                  "params": {}},
    "verify_open":       {"tool": "open",                             "params": {"path": "path"}},
    "verify_measure":    {"tool": "measure",                          "params": {"summary": "summary"}},
    "list_components":   {"command": "component.list",             "params": {"compact": "compact", "bodies": "bodies"}},
    "component_links":   {"command": "component.links",            "params": {}},
    "occurrence_props":  {"command": "occurrence.properties",      "params": {"occurrence": "occurrence", "path": "path", "descendants": "descendants"}},
    "interference":      {"command": "inspect.interference",       "params": {"bodies": "bodies", "budget_s": "budget_s", "exclude_pairs": "exclude_pairs"}, "timeout_s": 3600}
  },
  "verify": {
    "about": "How `inv2sc verify` reads SolidCraft's answers (JSON pointers; matrices are row-vector: the translation is the last row). Written against SolidCraft 0.44.",
    "open_result": {"name": "name", "bodies": "bodies"},
    "components": {"list": "components", "id": "id", "name": "name", "children": "children", "occurrences": "occurrences", "occurrence_id": "id", "occurrence_name": "name", "transform": "transform"},
    "links": {"list": "links", "component": "component", "file": "file", "found": "found"},
    "props": {"bodies": "bodies", "closed": "closed", "total": "total", "volume": "volume_mm3", "mass": "mass_g", "com": "center_of_mass", "inertia": "inertia_g_mm2", "bbox": "bbox", "open_skipped": "open_bodies_skipped"},
    "measure": {"bodies": "bodies", "name": "name", "closed": "closed", "volume": "volume_mm3", "bbox": "bbox"},
    "interference": {"pairs": "interferences", "a": "a", "b": "b", "volume": "volume_mm3", "unchecked": "unchecked", "budget_exceeded": "budget_exceeded", "a_part": "a_part", "b_part": "b_part", "path": "path", "bbox": "bbox"}
  },
  "origin_forms": {
    "frame": {"point": "point", "z": "z", "x": "x", "occurrence": "occurrence", "path": "path"},
    "face": "face",
    "circle": "circle"
  },
  "runner": {
    "about": "How the step runner talks to SolidCraft's MCP server beyond `execute`: how long a call may take (seconds; an op's own timeout_s wins), the `batch` tool (several commands in one call, run in order, stopping at the first error) and what a bridged call that is still running in the app answers.",
    "timeout_s": 300,
    "tool_timeout_s": {"save": 600, "open": 600},
    "batch": {
      "tool": "batch", "commands": "commands", "step_command": "command", "step_params": "params",
      "args": {"rollback": false, "timings": true, "verbose": false},
      "results": "/results", "failed_index": "/failed/index", "failed_error": "/failed/error", "rolled_back": "/rolled_back",
      "timings": "/timings", "timing_index": "index", "timing_ms": "ms"
    },
    "still_running": {"marker": "still running:", "pending_tool": "pending", "done": "/done", "result": "/result", "cancel_tool": "cancel"}
  },
  "mechanism": {
    "about": "The mechanism check after the assembly is saved (`verify_joints`): `joint_list` once for the degrees of freedom, conflicts and floating chains, then each joint of a type in `drive_types` driven a little (`test_move`, within its limits) with `drive` and back. Pointers (starting /) and keys into SolidCraft's replies.",
    "drive_types": ["revolute", "slider", "cylindrical"],
    "test_move": {"deg": 5, "mm": 1},
    "list": {"dof": "/dof", "dof_value": "dof", "dof_occurrence": "occurrence", "fixed": "/fixed", "conflicts": "/conflicts", "errors": "/errors", "floating": "/floating",
             "chain_occurrences": "occurrences", "chain_joints": "joints", "problem_name": "name", "problem_why": "why",
             "joints": "/joints", "joint_name": "name", "joint_values": "values", "value": "value", "value_limits": "limits", "value_unit": "unit"},
    "guard": {"about": "A step with a guard (constraints and joints) is undone with the `undo` op when it moves a guarded placement: `occurrence_props` before and after, compared by these pointers within tol_mm.",
              "points": ["/total/center_of_mass", "/total/bbox/min", "/total/bbox/max"], "tol_mm": 0.01},
    "drive": {"moved": "/moved", "reason": "/reason", "values": "/values", "stopped_by_loop": "/stopped_by_loop", "stopped_by_contact": "/stopped_by_contact", "conflicts": "/conflicts"}
  },
  "limits": {
    "about": "The limits stage (`joint_limits`, a runner step): each joint value swept with the `sweep` op from where it is, a turn (or the parts' reach) each way, against the parts it can meet, with a time budget each way; a limit is set with `set_limits` only where both ways end at a contact. Pointers and values in the `sweep` op's reply.",
    "stopped_at": "/stopped_at", "stopped_by": "/stopped_by", "ran_out": "/budget_ran_out",
    "contact_a": "a", "contact_b": "b", "contact_at": "at", "touching_parts": "/touching_parts", "path_ids": "path_ids",
    "loop": "loop", "limit": "limit", "budget": "budget",
    "slack_s": 120
  },
  "fallbacks": {
    "rigid_group": ["joint"]
  }
}
